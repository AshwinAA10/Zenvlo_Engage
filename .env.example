# Node Environment
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zenvlo_engage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zenvlo_engage

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_zenvlo_engage_production_change_me
JWT_EXPIRATION=3600s
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_zenvlo_engage_production_change_me
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WhatsApp Provider Integration
# Use 'mock' for local development & testing. In production, 'zenvlo' is strictly enforced.
WHATSAPP_PROVIDER=mock
ZENVLO_WHATSAPP_API_URL=https://api.zenvlo.com/v1/messages
ZENVLO_WHATSAPP_API_KEY=
WHATSAPP_TIMEOUT_MS=10000

# Meta WhatsApp & Instagram Integration Placeholders
META_APP_ID=placeholder_meta_app_id
META_APP_SECRET=placeholder_meta_app_secret
WHATSAPP_VERIFY_TOKEN=placeholder_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_access_token
INSTAGRAM_APP_ID=placeholder_instagram_app_id
INSTAGRAM_APP_SECRET=placeholder_instagram_app_secret
