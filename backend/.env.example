NODE_ENV=development
PORT=4000

# PostgreSQL / TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zenvlo_engage

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=zenvlo_engage_dev_secret_key_change_in_production
JWT_EXPIRATION=3600s
JWT_REFRESH_SECRET=zenvlo_engage_dev_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# WhatsApp Provider Integration
# Use 'mock' for local development & testing. In production, 'zenvlo' is strictly enforced.
WHATSAPP_PROVIDER=mock
ZENVLO_WHATSAPP_API_URL=https://api.zenvlo.com/v1/messages
ZENVLO_WHATSAPP_API_KEY=
WHATSAPP_TIMEOUT_MS=10000

# Meta Placeholders
META_APP_ID=placeholder_meta_app_id
META_APP_SECRET=placeholder_meta_app_secret
WHATSAPP_VERIFY_TOKEN=placeholder_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_access_token
INSTAGRAM_APP_ID=placeholder_instagram_app_id
INSTAGRAM_APP_SECRET=placeholder_instagram_app_secret
