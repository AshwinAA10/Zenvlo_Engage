# =================================================================
# Zenvlo Engage - Production Environment Configuration
# =================================================================

# Server Environment
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.zenvlo.com
CORS_ORIGIN=https://app.zenvlo.com

# PostgreSQL Database (TimescaleDB / Managed PostgreSQL)
POSTGRES_HOST=postgres.zenvlo.internal
POSTGRES_PORT=5432
POSTGRES_USER=zenvlo_engage_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=zenvlo_engage
POSTGRES_SSL=true

# Redis Cache & Message Broker
REDIS_HOST=redis.zenvlo.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_TLS=true

# JWT Authentication (HS256 or RS256)
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_security
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_64_characters_long
JWT_REFRESH_EXPIRATION=30d

# S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zenvlo-engage-media-production
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Razorpay India Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key_here

# Zenvlo Engage WhatsApp Integration
ZENVLO_WHATSAPP_API_URL=https://api.zenvlo.com/v1/messages
ZENVLO_WHATSAPP_API_KEY=your_internal_zenvlo_engage_api_key

# Google Places Read-Only Review Integration
GOOGLE_PLACES_API_KEY=your_google_cloud_places_api_key_here

# Frontend Next.js Client
NEXT_PUBLIC_API_URL=https://api.zenvlo.com/api
NEXT_PUBLIC_APP_URL=https://app.zenvlo.com
